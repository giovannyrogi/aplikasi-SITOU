# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# hris_perumda_postgresql.sql
/uploads/*
!/uploads/.gitkeep
/database/*
!/database/migrations/
!/database/migrations/*.sql
!/database/migrations/README.md
/scripts/*
!/scripts/cleanup-replaced-profile-files.mjs
!/scripts/file-cleanup-worker.mjs
!/scripts/test-storage-maintenance-http.mjs
!/scripts/test-storage-maintenance-db.mjs
!/scripts/verify-schema-bootstrap.mjs
/tests/*
!/tests/storage-maintenance.test.mjs
/ecosystem.config.js

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
